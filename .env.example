# Database
POSTGRES_DB=tourism
POSTGRES_USER=tourism
POSTGRES_PASSWORD=tourism

# Production Supabase connection strings (configure as secrets in Render).
# DATABASE_URL is the pooler URL used by the running API.
# DIRECT_URL is reserved for direct-session migrations and maintenance.
# Do not commit real credentials.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<db-host>:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-in-production
JWT_EXPIRATION=86400000

# Admin seed credentials
ADMIN_EMAIL=admin@tamaka.com
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=System Administrator

# Cloudflare R2 object storage (keep secrets only in Render/local env files)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-domain>